# ---------- Docker (docker-compose.yml) ----------
POSTGRES_USER=medibook
POSTGRES_PASSWORD=medibook
POSTGRES_DB=medibook_hms

# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://medibook:medibook@localhost:5434/medibook_hms?schema=public
REDIS_URL=redis://localhost:6380

# Auth / sessions (replace with a long random string in .env; also used to hash tokens)
JWT_SECRET=change-me-to-a-long-random-string
# Public URL of the web app (used in set-password email links)
APP_URL=http://localhost:5173
# Idle timeouts: staff 15 min, patients 30 min; absolute session lifetime 12 h
SESSION_IDLE_MINUTES=15
PATIENT_SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Secure cookies (browsers allow them on http://localhost); set false only for non-localhost plain http
COOKIE_SECURE=true

# Staff passwords: bcrypt cost, min length, lock after 5 wrong passwords for 15 min, set-password link valid 24 h
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_ATTEMPTS=5
PASSWORD_LOCK_MINUTES=15
SET_PASSWORD_LINK_HOURS=24

# OTP rules (from docs/mvp-structure.md)
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# Slot holds in Redis
SLOT_HOLD_SECONDS=600

# Request limits on the public auth endpoints, per client IP per window (on top of the per-account OTP/password locks):
# staff login / patient OTP request / registration, the same per IP + staff ID or email, and OTP verify/resend/set-password.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_LOGIN_PER_ACCOUNT=10
RATE_LIMIT_OTP_PER_IP=60

# Online prepayment (patient portal / chatbot "Pay now"). Only the simulated gateway exists: UPI ID fail@upi or a card
# ending 0002 fails, anything else succeeds. Webhooks are HMAC-signed; leave the secret empty to derive it from JWT_SECRET.
PAYMENT_PROVIDER=simulated
PAYMENT_WEBHOOK_SECRET=
PAYMENT_SIM_DELAY_MS=2000

# Result attachments (PDF / image reports), relative to /server. Never served statically.
UPLOAD_DIR=uploads

# ---------- Email (Nodemailer + Gmail SMTP) ----------
# MAIL_TRANSPORT: smtp = really send; console = print emails in the server log ([mail:dev]).
# Leave empty to pick automatically: smtp when SMTP_USER and SMTP_PASS are set, otherwise console.
# The server logs the active transport at startup and checks the SMTP login (it keeps running if the check fails).
# In development every OTP is also printed to the server console ([otp:dev]); never in production.
#
# Gmail App Password (needed — your normal Gmail password will be rejected with 535):
#   1. Google Account → Security → turn on 2-Step Verification.
#   2. Open https://myaccount.google.com/apppasswords, enter a name (e.g. "MediBook"), click Create.
#   3. Copy the 16-character password into SMTP_PASS without spaces.
# Test it with: npm run mail:test -- you@example.com
MAIL_TRANSPORT=
SMTP_HOST=smtp.gmail.com
# 465 = TLS from the start (SMTP_SECURE=true). If 465 is blocked on your network use 587 with SMTP_SECURE=false.
SMTP_PORT=465
SMTP_SECURE=true
# Your Gmail address
SMTP_USER=
# 16-character Gmail App Password, no spaces
SMTP_PASS=
# Gmail sends as SMTP_USER, so use the same address here
MAIL_FROM="MediBook <your.address@gmail.com>"

# Seed: initial Super Admin (staff ID is generated: HMS-SUP-0001). The password is only used by db:seed
# and must be at least 10 characters. Every other seeded user gets SEED_STAFF_PASSWORD.
SEED_SUPERADMIN_EMAIL=superadmin@medibook.local
SEED_SUPERADMIN_PASSWORD=ChangeMe!2026
SEED_STAFF_PASSWORD=MediBook@2026

# ---------- Web (Vite; only VITE_* vars reach the browser) ----------
VITE_API_URL=http://localhost:4000
