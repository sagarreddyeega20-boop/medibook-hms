# ---------- Docker (docker-compose.yml) ----------
POSTGRES_USER=medibook
POSTGRES_PASSWORD=medibook
POSTGRES_DB=medibook_hms

# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://medibook:medibook@localhost:5434/medibook_hms?schema=public
REDIS_URL=redis://localhost:6380

# Auth / sessions (replace with a long random string in .env)
JWT_SECRET=change-me-to-a-long-random-string
SESSION_IDLE_MINUTES=15

# OTP rules (from docs/mvp-structure.md)
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# Slot holds in Redis
SLOT_HOLD_SECONDS=600

# Email (Nodemailer). Leave SMTP_HOST empty in dev to log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MediBook HMS <no-reply@medibook.local>"

# Seed: initial Super Admin (password is only used by db:seed)
SEED_SUPERADMIN_STAFF_ID=SA0001
SEED_SUPERADMIN_EMAIL=superadmin@medibook.local
SEED_SUPERADMIN_PASSWORD=ChangeMe!2026

# ---------- Web (Vite; only VITE_* vars reach the browser) ----------
VITE_API_URL=http://localhost:4000
