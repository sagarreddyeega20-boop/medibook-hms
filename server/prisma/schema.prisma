// MediBook HMS — full MVP schema (docs/mvp-structure.md).
// Conventions: snake_case tables/columns, money in integer paise, all timestamps UTC (timestamptz).
// THE VISIT IS THE CENTRE: notes, vitals, orders, prescriptions and charges hang from visits.
// Partial unique index preventing double-booking lives in the init migration (raw SQL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum RoleCode {
  SUPER_ADMIN
  ADMIN
  RECEPTIONIST
  DOCTOR
  LAB_TECH
  RADIOLOGY_TECH
  PHARMACIST
  ACCOUNTS
  PATIENT
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum DepartmentKind {
  CLINICAL
  LAB
  RADIOLOGY
  PHARMACY
  ADMIN
  BILLING
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum ConsentType {
  DATA_PROCESSING
  TREATMENT
  COMMUNICATION
  DATA_SHARING
}

enum DataRequestType {
  NONE
  DOWNLOAD
  CORRECTION
  ERASURE
}

enum AppointmentStatus {
  HELD
  BOOKED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  RECEPTION
  ONLINE
}

enum QueueEventType {
  CHECKED_IN
  TOKEN_ISSUED
  CALLED
  CONSULT_STARTED
  CONSULT_ENDED
  SKIPPED
  RESCHEDULED
  CANCELLED
}

enum VisitType {
  OPD
  WALK_IN
  IPD       // reserved: inpatient release
  EMERGENCY // reserved: hospital-wide release
}

enum VisitStatus {
  OPEN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
}

enum NoteType {
  CONSULTATION
  PROGRESS
  REFERRAL_RESPONSE
  ADDENDUM
}

enum OrderType {
  LAB
  RADIOLOGY
  REFERRAL
  MEDICATION
}

enum OrderStatus {
  ORDERED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  RESULT_READY
  CANCELLED
}

enum OrderPriority {
  ROUTINE
  URGENT
  STAT
}

enum PrescriptionStatus {
  ACTIVE
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  DISPENSE
  ADJUSTMENT
  RETURN
}

enum CatalogueCategory {
  CONSULTATION
  LAB_TEST
  RADIOLOGY_SCAN
  PROCEDURE
  MEDICINE
  OTHER
}

enum ChargeStatus {
  PENDING
  INVOICED
  VOID
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

enum OtpPurpose {
  STAFF_LOGIN
  PATIENT_LOGIN
  PASSWORD_RESET
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

// =====================================================================
// PEOPLE AND ACCESS — module: auth / staff / patients
// =====================================================================

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique
  passwordHash       String?    @map("password_hash") // null for patients (OTP-only)
  status             UserStatus @default(ACTIVE)
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles              UserRole[]
  staff              Staff?
  patient            Patient?   @relation("PatientAccount")
  otpRequests        OtpRequest[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  accessOverrides    AccessOverride[] @relation("OverrideUser")
  approvedOverrides  AccessOverride[] @relation("OverrideApprover")
  createdUsers       User[]     @relation("UserCreatedBy")
  createdBy          User?      @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdById        String?    @map("created_by_id") @db.Uuid

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        RoleCode         @unique
  name        String
  description String?
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique // e.g. "clinical_notes:read"
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Department {
  id        String         @id @default(uuid()) @db.Uuid
  code      String         @unique // e.g. CARD, LAB, RAD, PHARM
  name      String
  kind      DepartmentKind @default(CLINICAL)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  staff            Staff[]
  visits           Visit[]
  appointments     Appointment[]
  ordersTargeted   Order[]            @relation("OrderTargetDepartment")
  referralsTo      Referral[]         @relation("ReferralToDepartment")
  catalogueItems   ServiceCatalogue[]
  charges          Charge[]
  invoiceLines     InvoiceLine[]

  @@map("departments")
}

model Staff {
  id                    String      @id @default(uuid()) @db.Uuid
  userId                String      @unique @map("user_id") @db.Uuid
  staffCode             String      @unique @map("staff_code") // hospital-issued staff ID
  fullName              String      @map("full_name")
  phone                 String?
  designation           String?
  specialty             String?
  departmentId          String?     @map("department_id") @db.Uuid
  consultationFeePaise  Int?        @map("consultation_fee_paise")
  slotMinutes           Int?        @default(15) @map("slot_minutes")
  isActive              Boolean     @default(true) @map("is_active")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                  User        @relation(fields: [userId], references: [id])
  department            Department? @relation(fields: [departmentId], references: [id])

  schedules             DoctorSchedule[]
  leaves                DoctorLeave[]
  appointments          Appointment[]
  visits                Visit[]
  clinicalNotes         ClinicalNote[]
  vitalsRecorded        Vital[]
  ordersPlaced          Order[]         @relation("OrderingDoctor")
  ordersTargeted        Order[]         @relation("OrderTargetDoctor")
  ordersAssigned        Order[]         @relation("OrderAssignee")
  resultsReported       OrderResult[]
  referralsMade         Referral[]      @relation("ReferralFrom")
  referralsReceived     Referral[]      @relation("ReferralTo")
  prescriptions         Prescription[]
  dispensations         Dispensation[]
  stockMovements        StockMovement[]
  queueEvents           QueueEvent[]
  paymentsReceived      Payment[]
  refundsApproved       Refund[]
  invoicesIssued        Invoice[]
  chargesCreated        Charge[]
  consentsRecorded      Consent[]
  patientsRegistered    Patient[]

  @@index([departmentId])
  @@map("staff")
}

model Patient {
  id               String    @id @default(uuid()) @db.Uuid
  mrn              String    @unique // hospital patient ID
  userId           String?   @unique @map("user_id") @db.Uuid // portal account (optional)
  firstName        String    @map("first_name")
  lastName         String?   @map("last_name")
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  gender           Gender    @default(UNKNOWN)
  phone            String?
  email            String?
  address          String?
  bloodGroup       String?   @map("blood_group")
  allergies        String?
  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")
  registeredById   String?   @map("registered_by_id") @db.Uuid
  registrationSource BookingSource @default(RECEPTION) @map("registration_source")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User?     @relation("PatientAccount", fields: [userId], references: [id])
  registeredBy     Staff?    @relation(fields: [registeredById], references: [id])
  familyMembers    FamilyMember[] @relation("FamilyAccountHolder")
  familyOf         FamilyMember[] @relation("FamilyMemberPatient")
  consents         Consent[]
  appointments     Appointment[]
  visits           Visit[]
  orders           Order[]
  referrals        Referral[]
  prescriptions    Prescription[]
  invoices         Invoice[]
  payments         Payment[]
  auditLogs        AuditLog[]
  accessOverrides  AccessOverride[]
  queueEvents      QueueEvent[]

  // duplicate detection: same name + date of birth + phone
  @@index([firstName, lastName, dateOfBirth, phone], map: "patients_duplicate_check_idx")
  @@index([phone])
  @@map("patients")
}

// A patient account holder can manage family members, who are patients themselves.
model FamilyMember {
  id               String   @id @default(uuid()) @db.Uuid
  accountPatientId String   @map("account_patient_id") @db.Uuid
  memberPatientId  String   @map("member_patient_id") @db.Uuid
  relationship     String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  accountPatient   Patient  @relation("FamilyAccountHolder", fields: [accountPatientId], references: [id], onDelete: Cascade)
  memberPatient    Patient  @relation("FamilyMemberPatient", fields: [memberPatientId], references: [id], onDelete: Cascade)

  @@unique([accountPatientId, memberPatientId])
  @@map("family_members")
}

// DPDP Act 2023: consent records and data-rights requests.
model Consent {
  id            String          @id @default(uuid()) @db.Uuid
  patientId     String          @map("patient_id") @db.Uuid
  type          ConsentType
  granted       Boolean
  version       String          @default("1")
  requestType   DataRequestType @default(NONE) @map("request_type")
  requestStatus String?         @map("request_status")
  recordedById  String?         @map("recorded_by_id") @db.Uuid
  grantedAt     DateTime        @default(now()) @map("granted_at") @db.Timestamptz(3)
  withdrawnAt   DateTime?       @map("withdrawn_at") @db.Timestamptz(3)
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz(3)

  patient       Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy    Staff?          @relation(fields: [recordedById], references: [id])

  @@index([patientId])
  @@map("consents")
}

// =====================================================================
// SCHEDULING — module: scheduling / reception
// =====================================================================

model DoctorSchedule {
  id            String    @id @default(uuid()) @db.Uuid
  doctorId      String    @map("doctor_id") @db.Uuid
  dayOfWeek     Int       @map("day_of_week") // 0 = Sunday … 6 = Saturday (hospital local)
  startMinute   Int       @map("start_minute") // minutes from local midnight
  endMinute     Int       @map("end_minute")
  slotMinutes   Int       @default(15) @map("slot_minutes")
  effectiveFrom DateTime? @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  doctor        Staff     @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

model DoctorLeave {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  doctor    Staff    @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startsAt])
  @@map("doctor_leaves")
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  ref            String            @unique // human booking reference, e.g. APT-000123 ("cancel APT-000123")
  patientId      String            @map("patient_id") @db.Uuid
  doctorId       String            @map("doctor_id") @db.Uuid
  departmentId   String            @map("department_id") @db.Uuid
  slotStart      DateTime          @map("slot_start") @db.Timestamptz(3)
  slotEnd        DateTime          @map("slot_end") @db.Timestamptz(3)
  status         AppointmentStatus @default(BOOKED)
  source         BookingSource     @default(RECEPTION)
  reason         String?
  tokenNumber    Int?              @map("token_number")
  rescheduledFromId String?        @map("rescheduled_from_id") @db.Uuid
  cancelledAt    DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelReason   String?           @map("cancel_reason")
  checkedInAt    DateTime?         @map("checked_in_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient        Patient           @relation(fields: [patientId], references: [id])
  doctor         Staff             @relation(fields: [doctorId], references: [id])
  department     Department        @relation(fields: [departmentId], references: [id])
  rescheduledFrom Appointment?     @relation("Reschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo  Appointment[]     @relation("Reschedule")
  visit          Visit?
  queueEvents    QueueEvent[]

  // NOTE: uniqueness of (doctor_id, slot_start) for non-cancelled rows is a partial
  // unique index created in the migration: appointments_doctor_slot_active_uniq.
  @@index([doctorId, slotStart])
  @@index([patientId])
  @@map("appointments")
}

model QueueEvent {
  id            String         @id @default(uuid()) @db.Uuid
  appointmentId String?        @map("appointment_id") @db.Uuid
  visitId       String?        @map("visit_id") @db.Uuid
  patientId     String         @map("patient_id") @db.Uuid
  doctorId      String?        @map("doctor_id") @db.Uuid
  type          QueueEventType
  tokenNumber   Int?           @map("token_number")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  visit         Visit?         @relation(fields: [visitId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  doctor        Staff?         @relation(fields: [doctorId], references: [id])

  @@index([doctorId, createdAt])
  @@map("queue_events")
}

// =====================================================================
// CLINICAL — module: visits / orders  (THE VISIT IS THE CENTRE)
// =====================================================================

model Visit {
  id            String      @id @default(uuid()) @db.Uuid
  visitNumber   String      @unique @map("visit_number")
  patientId     String      @map("patient_id") @db.Uuid
  appointmentId String?     @unique @map("appointment_id") @db.Uuid // null for walk-ins
  departmentId  String      @map("department_id") @db.Uuid
  doctorId      String      @map("doctor_id") @db.Uuid
  type          VisitType
  status        VisitStatus @default(OPEN)
  chiefComplaint String?    @map("chief_complaint")
  tokenNumber   Int?        @map("token_number")
  startedAt     DateTime    @default(now()) @map("started_at") @db.Timestamptz(3)
  consultStartedAt DateTime? @map("consult_started_at") @db.Timestamptz(3)
  endedAt       DateTime?   @map("ended_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient       Patient     @relation(fields: [patientId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  department    Department  @relation(fields: [departmentId], references: [id])
  doctor        Staff       @relation(fields: [doctorId], references: [id])

  clinicalNotes ClinicalNote[]
  vitals        Vital[]
  orders        Order[]
  prescriptions Prescription[]
  charges       Charge[]
  invoices      Invoice[]
  queueEvents   QueueEvent[]
  referralsMade Referral[]  @relation("ReferralFromVisit")
  referralsIn   Referral[]  @relation("ReferralToVisit")

  @@index([patientId, startedAt])
  @@index([doctorId, status])
  @@index([departmentId, startedAt])
  @@map("visits")
}

model ClinicalNote {
  id           String   @id @default(uuid()) @db.Uuid
  visitId      String   @map("visit_id") @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  type         NoteType @default(CONSULTATION)
  subjective   String?
  objective    String?
  assessment   String?
  plan         String?
  diagnosis    String?
  diagnosisCode String? @map("diagnosis_code") // ICD-10 (optional)
  body         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  visit        Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  author       Staff    @relation(fields: [authorId], references: [id])

  @@index([visitId])
  @@map("clinical_notes")
}

// Vitals hang from the visit (spec: "notes, vitals"). Added so the inpatient nurse station has a home.
model Vital {
  id             String   @id @default(uuid()) @db.Uuid
  visitId        String   @map("visit_id") @db.Uuid
  recordedById   String   @map("recorded_by_id") @db.Uuid
  temperatureC   Decimal? @map("temperature_c") @db.Decimal(4, 1)
  pulseBpm       Int?     @map("pulse_bpm")
  systolicMmHg   Int?     @map("systolic_mmhg")
  diastolicMmHg  Int?     @map("diastolic_mmhg")
  respiratoryRate Int?    @map("respiratory_rate")
  spo2Percent    Int?     @map("spo2_percent")
  weightKg       Decimal? @map("weight_kg") @db.Decimal(5, 2)
  heightCm       Decimal? @map("height_cm") @db.Decimal(5, 1)
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  visit          Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  recordedBy     Staff    @relation(fields: [recordedById], references: [id])

  @@index([visitId])
  @@map("vitals")
}

model Order {
  id                 String        @id @default(uuid()) @db.Uuid
  orderNumber        String        @unique @map("order_number")
  visitId            String        @map("visit_id") @db.Uuid
  patientId          String        @map("patient_id") @db.Uuid
  type               OrderType
  status             OrderStatus   @default(ORDERED)
  priority           OrderPriority @default(ROUTINE)
  orderingDoctorId   String        @map("ordering_doctor_id") @db.Uuid
  targetDepartmentId String        @map("target_department_id") @db.Uuid
  targetDoctorId     String?       @map("target_doctor_id") @db.Uuid
  assignedToId       String?       @map("assigned_to_id") @db.Uuid
  catalogueItemId    String?       @map("catalogue_item_id") @db.Uuid
  title              String
  clinicalNotes      String?       @map("clinical_notes") // reason / indication
  scheduledFor       DateTime?     @map("scheduled_for") @db.Timestamptz(3)
  startedAt          DateTime?     @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?     @map("completed_at") @db.Timestamptz(3)
  resultReadyAt      DateTime?     @map("result_ready_at") @db.Timestamptz(3)
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelReason       String?       @map("cancel_reason")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  visit              Visit         @relation(fields: [visitId], references: [id])
  patient            Patient       @relation(fields: [patientId], references: [id])
  orderingDoctor     Staff         @relation("OrderingDoctor", fields: [orderingDoctorId], references: [id])
  targetDepartment   Department    @relation("OrderTargetDepartment", fields: [targetDepartmentId], references: [id])
  targetDoctor       Staff?        @relation("OrderTargetDoctor", fields: [targetDoctorId], references: [id])
  assignedTo         Staff?        @relation("OrderAssignee", fields: [assignedToId], references: [id])
  catalogueItem      ServiceCatalogue? @relation(fields: [catalogueItemId], references: [id])

  results            OrderResult[]
  referral           Referral?
  prescription       Prescription?
  charges            Charge[]

  @@index([targetDepartmentId, type, status])
  @@index([patientId])
  @@index([visitId])
  @@map("orders")
}

model OrderResult {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  reportedById String   @map("reported_by_id") @db.Uuid
  summary      String?
  values       Json?    // structured results, e.g. [{ name, value, unit, range, flag }]
  fileUrl      String?  @map("file_url")
  isAbnormal   Boolean  @default(false) @map("is_abnormal")
  reportedAt   DateTime @default(now()) @map("reported_at") @db.Timestamptz(3)

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reportedBy   Staff    @relation(fields: [reportedById], references: [id])

  @@index([orderId])
  @@map("order_results")
}

// A referral is an Order of type REFERRAL; this row holds referral-specific detail.
model Referral {
  id               String      @id @default(uuid()) @db.Uuid
  orderId          String      @unique @map("order_id") @db.Uuid
  patientId        String      @map("patient_id") @db.Uuid
  fromVisitId      String      @map("from_visit_id") @db.Uuid
  fromDoctorId     String      @map("from_doctor_id") @db.Uuid
  toDepartmentId   String      @map("to_department_id") @db.Uuid
  toDoctorId       String?     @map("to_doctor_id") @db.Uuid
  toVisitId        String?     @map("to_visit_id") @db.Uuid // visit created when referral is seen
  reason           String
  response         String?
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patient          Patient     @relation(fields: [patientId], references: [id])
  fromVisit        Visit       @relation("ReferralFromVisit", fields: [fromVisitId], references: [id])
  fromDoctor       Staff       @relation("ReferralFrom", fields: [fromDoctorId], references: [id])
  toDepartment     Department  @relation("ReferralToDepartment", fields: [toDepartmentId], references: [id])
  toDoctor         Staff?      @relation("ReferralTo", fields: [toDoctorId], references: [id])
  toVisit          Visit?      @relation("ReferralToVisit", fields: [toVisitId], references: [id])

  @@index([toDoctorId])
  @@index([patientId])
  @@map("referrals")
}

model Prescription {
  id          String             @id @default(uuid()) @db.Uuid
  visitId     String             @map("visit_id") @db.Uuid
  patientId   String             @map("patient_id") @db.Uuid
  doctorId    String             @map("doctor_id") @db.Uuid
  orderId     String?            @unique @map("order_id") @db.Uuid // MEDICATION order
  status      PrescriptionStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  visit       Visit              @relation(fields: [visitId], references: [id])
  patient     Patient            @relation(fields: [patientId], references: [id])
  doctor      Staff              @relation(fields: [doctorId], references: [id])
  order       Order?             @relation(fields: [orderId], references: [id])
  items       PrescriptionItem[]

  @@index([status, createdAt])
  @@index([patientId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id              String        @id @default(uuid()) @db.Uuid
  prescriptionId  String        @map("prescription_id") @db.Uuid
  medicineId      String?       @map("medicine_id") @db.Uuid
  medicineName    String        @map("medicine_name") // as written by the doctor
  dose            String?
  frequency       String?
  durationDays    Int?          @map("duration_days")
  route           String?
  instructions    String?
  quantity        Int
  dispensedQuantity Int         @default(0) @map("dispensed_quantity")

  prescription    Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine        Medicine?     @relation(fields: [medicineId], references: [id])
  dispensations   Dispensation[]

  @@index([prescriptionId])
  @@map("prescription_items")
}

// =====================================================================
// PHARMACY — module: pharmacy
// =====================================================================

model Medicine {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique
  name               String
  genericName        String?  @map("generic_name")
  form               String?  // tablet, syrup, injection …
  strength           String?
  unit               String   @default("unit")
  purchasePricePaise Int      @map("purchase_price_paise")
  sellingPricePaise  Int      @map("selling_price_paise")
  stockQuantity      Int      @default(0) @map("stock_quantity") // denormalised; changed only with a stock_movements row
  reorderLevel       Int      @default(10) @map("reorder_level") // low-stock alert threshold
  catalogueItemId    String?  @unique @map("catalogue_item_id") @db.Uuid
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  catalogueItem      ServiceCatalogue? @relation(fields: [catalogueItemId], references: [id])
  prescriptionItems  PrescriptionItem[]
  stockMovements     StockMovement[]
  dispensations      Dispensation[]

  @@index([name])
  @@map("medicines")
}

model StockMovement {
  id                 String            @id @default(uuid()) @db.Uuid
  medicineId         String            @map("medicine_id") @db.Uuid
  type               StockMovementType
  quantity           Int               // signed: + in, - out
  unitCostPaise      Int?              @map("unit_cost_paise")
  dispensationId     String?           @unique @map("dispensation_id") @db.Uuid
  reference          String?
  performedById      String            @map("performed_by_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  medicine           Medicine          @relation(fields: [medicineId], references: [id])
  dispensation       Dispensation?     @relation(fields: [dispensationId], references: [id])
  performedBy        Staff             @relation(fields: [performedById], references: [id])

  @@index([medicineId, createdAt])
  @@map("stock_movements")
}

model Dispensation {
  id                  String           @id @default(uuid()) @db.Uuid
  prescriptionItemId  String           @map("prescription_item_id") @db.Uuid
  medicineId          String           @map("medicine_id") @db.Uuid
  quantity            Int
  unitPricePaise      Int              @map("unit_price_paise") // selling price at time of dispense
  unitCostPaise       Int              @map("unit_cost_paise")  // purchase price at time of dispense (margin)
  dispensedById       String           @map("dispensed_by_id") @db.Uuid
  dispensedAt         DateTime         @default(now()) @map("dispensed_at") @db.Timestamptz(3)

  prescriptionItem    PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  medicine            Medicine         @relation(fields: [medicineId], references: [id])
  dispensedBy         Staff            @relation(fields: [dispensedById], references: [id])
  stockMovement       StockMovement?
  charge              Charge?

  @@index([dispensedAt])
  @@map("dispensations")
}

// =====================================================================
// MONEY — module: billing / accounts
// =====================================================================

model ServiceCatalogue {
  id           String            @id @default(uuid()) @db.Uuid
  code         String            @unique
  name         String
  category     CatalogueCategory
  departmentId String            @map("department_id") @db.Uuid
  pricePaise   Int               @map("price_paise")
  taxPercent   Int               @default(0) @map("tax_percent")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  department   Department        @relation(fields: [departmentId], references: [id])
  charges      Charge[]
  orders       Order[]
  medicine     Medicine?

  @@index([departmentId])
  @@map("service_catalogue")
}

model Charge {
  id              String           @id @default(uuid()) @db.Uuid
  visitId         String           @map("visit_id") @db.Uuid
  catalogueItemId String           @map("catalogue_item_id") @db.Uuid
  departmentId    String           @map("department_id") @db.Uuid
  orderId         String?          @map("order_id") @db.Uuid
  dispensationId  String?          @unique @map("dispensation_id") @db.Uuid
  description     String
  quantity        Int              @default(1)
  unitPricePaise  Int              @map("unit_price_paise")
  discountPaise   Int              @default(0) @map("discount_paise")
  totalPaise      Int              @map("total_paise")
  status          ChargeStatus     @default(PENDING)
  createdById     String?          @map("created_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  visit           Visit            @relation(fields: [visitId], references: [id])
  catalogueItem   ServiceCatalogue @relation(fields: [catalogueItemId], references: [id])
  department      Department       @relation(fields: [departmentId], references: [id])
  order           Order?           @relation(fields: [orderId], references: [id])
  dispensation    Dispensation?    @relation(fields: [dispensationId], references: [id])
  createdBy       Staff?           @relation(fields: [createdById], references: [id])
  invoiceLine     InvoiceLine?

  @@index([visitId])
  @@index([departmentId, createdAt])
  @@map("charges")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number")
  visitId        String        @map("visit_id") @db.Uuid // one bill per visit
  patientId      String        @map("patient_id") @db.Uuid
  status         InvoiceStatus @default(DRAFT)
  subtotalPaise  Int           @default(0) @map("subtotal_paise")
  discountPaise  Int           @default(0) @map("discount_paise")
  taxPaise       Int           @default(0) @map("tax_paise")
  totalPaise     Int           @default(0) @map("total_paise")
  paidPaise      Int           @default(0) @map("paid_paise")
  issuedById     String?       @map("issued_by_id") @db.Uuid
  issuedAt       DateTime?     @map("issued_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  visit          Visit         @relation(fields: [visitId], references: [id])
  patient        Patient       @relation(fields: [patientId], references: [id])
  issuedBy       Staff?        @relation(fields: [issuedById], references: [id])
  lines          InvoiceLine[]
  allocations    PaymentAllocation[]
  refunds        Refund[]

  @@index([visitId])
  @@index([patientId])
  @@index([status, createdAt])
  @@map("invoices")
}

model InvoiceLine {
  id             String     @id @default(uuid()) @db.Uuid
  invoiceId      String     @map("invoice_id") @db.Uuid
  chargeId       String?    @unique @map("charge_id") @db.Uuid
  departmentId   String     @map("department_id") @db.Uuid
  description    String
  quantity       Int        @default(1)
  unitPricePaise Int        @map("unit_price_paise")
  discountPaise  Int        @default(0) @map("discount_paise")
  totalPaise     Int        @map("total_paise")

  invoice        Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  charge         Charge?    @relation(fields: [chargeId], references: [id])
  department     Department @relation(fields: [departmentId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  receiptNumber  String        @unique @map("receipt_number")
  patientId      String        @map("patient_id") @db.Uuid
  method         PaymentMethod
  status         PaymentStatus @default(CONFIRMED)
  amountPaise    Int           @map("amount_paise")
  reference      String?       // UPI txn id / card last4 / etc.
  idempotencyKey String        @unique @map("idempotency_key") // safe retries: never charge twice
  receivedById   String?       @map("received_by_id") @db.Uuid
  receivedAt     DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  patient        Patient       @relation(fields: [patientId], references: [id])
  receivedBy     Staff?        @relation(fields: [receivedById], references: [id])
  allocations    PaymentAllocation[]
  refunds        Refund[]

  @@index([receivedAt])
  @@index([method, receivedAt])
  @@map("payments")
}

// Payments ↔ invoices: one payment can cover several invoices, one invoice several payments.
model PaymentAllocation {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  amountPaise Int      @map("amount_paise")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model Refund {
  id           String       @id @default(uuid()) @db.Uuid
  paymentId    String       @map("payment_id") @db.Uuid
  invoiceId    String?      @map("invoice_id") @db.Uuid
  amountPaise  Int          @map("amount_paise")
  method       PaymentMethod
  reason       String
  status       RefundStatus @default(REQUESTED)
  approvedById String?      @map("approved_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt  DateTime?    @map("processed_at") @db.Timestamptz(3)

  payment      Payment      @relation(fields: [paymentId], references: [id])
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])
  approvedBy   Staff?       @relation(fields: [approvedById], references: [id])

  @@index([createdAt])
  @@map("refunds")
}

// =====================================================================
// SYSTEM — module: auth / notifications / audit
// =====================================================================

model OtpRequest {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  email       String
  purpose     OtpPurpose
  codeHash    String     @map("code_hash") // never store the plain code
  attempts    Int        @default(0)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(3)
  lockedUntil DateTime?  @map("locked_until") @db.Timestamptz(3)
  ip          String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@map("otp_requests")
}

model Notification {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String?             @map("user_id") @db.Uuid
  channel    NotificationChannel
  status     NotificationStatus  @default(QUEUED)
  recipient  String?             // email address for EMAIL channel
  subject    String?
  body       String
  data       Json?
  error      String?
  sentAt     DateTime?           @map("sent_at") @db.Timestamptz(3)
  readAt     DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("notifications")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   // e.g. VIEW, CREATE, UPDATE, DELETE, LOGIN, BREAK_GLASS
  entity    String   // e.g. clinical_notes
  entityId  String?  @map("entity_id")
  patientId String?  @map("patient_id") @db.Uuid
  reason    String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor     User?    @relation(fields: [actorId], references: [id])
  patient   Patient? @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// Break-glass: time-limited access to an unrelated patient's record, with a reason.
model AccessOverride {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  patientId    String    @map("patient_id") @db.Uuid
  reason       String
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  approvedById String?   @map("approved_by_id") @db.Uuid
  adminNotifiedAt DateTime? @map("admin_notified_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User      @relation("OverrideUser", fields: [userId], references: [id])
  approvedBy   User?     @relation("OverrideApprover", fields: [approvedById], references: [id])
  patient      Patient   @relation(fields: [patientId], references: [id])

  @@index([userId, patientId, expiresAt])
  @@map("access_overrides")
}

// Atomic counters for human-readable IDs: staff codes (HMS-DOC-0007) and MRNs (MB-2026-000001).
// Accessed with raw SQL (INSERT … ON CONFLICT … RETURNING) so concurrent creates never reuse a number.
model IdSequence {
  key       String   @id // e.g. "staff:DOC", "mrn:2026"
  value     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("id_sequences")
}

model Setting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}
